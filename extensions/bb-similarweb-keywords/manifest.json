{
  "manifest_version": 3,
  "name": "BB Similarweb Keywords",
  "version": "0.9.13",
  "description": "从 sim.3ue.co / sem.3ue.co 导出关键词表、关键词生成器、网站表现、着陆页、Semrush 域名概览、引荐域名、反向链接或自然排名。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "导出 Similarweb 数据到 CSV",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://sim.3ue.co/*", "https://*.3ue.co/*"],
  "content_scripts": [
    {
      "matches": ["https://sim.3ue.co/*", "https://*.3ue.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://sim.3ue.co/*", "https://*.3ue.co/*"],
      "js": ["page-main.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
